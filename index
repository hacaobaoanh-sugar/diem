<html lang="vi">
<head>
    <meta charset="UTF-8">
    <title>Tìm kiếm tự động</title>
    <style>
        /* Xóa khoảng trắng mặc định của toàn trang web */
        body {
            margin: 0;
            padding: 0;
            font-family: Arial, sans-serif;
        }
        
        .header-title {
            padding: 20px;
            background-color: #f8f9fa;
            border-bottom: 1px solid #ddd;
        }

        /* Khung chứa: Loại bỏ max-width và căn giữa để đẩy toàn bộ nội dung sát lề trái */
        .container {
            width: 100%;
            padding: 20px; /* Tạo một khoảng đệm nhẹ 20px với lề để dễ nhìn, bạn có thể sửa thành 0 nếu muốn sát 100% */
            box-sizing: border-box;
        }

        /* Khung cuộn bảng: Bắt đầu ngay tại mép trái của vùng hiển thị */
        .table-container {
            width: 100%;
            overflow-x: auto;
            border: 1px solid #ccc;
            margin-top: 15px;
        }

        table {
            border-collapse: collapse;
            width: 1000px; /* Giữ nguyên chiều rộng cố định để kích hoạt thanh cuộn ngang */
            margin-left: 0; /* Đảm bảo bảng luôn nằm sát lề trái của khung cuộn */
        }

        th, td {
            border: 1px solid blue;
            text-align: center;
            padding: 8px;
            white-space: nowrap;
            cursor: pointer;
			font-size: 15px;
        }

        th {
            background-color: #f2f2f2;
            color: blue;
        }

        input {
            padding: 10px;
            font-size: 16px;
            width: 300px; /* Thu gọn ô nhập liệu để cân đối với giao diện bên trái */
            box-sizing: border-box;
        }

        .no-results {
            color: red;
            font-size: 18px;
            margin-top: 15px;
        }
		
		table th {
			/* Giữ nguyên mã nguồn JS của bạn, CSS này sẽ tự động ép \n phải xuống dòng */
			white-space: pre-line; 
    
			/* Thêm một chút style cho dễ nhìn */
			text-align: center;
			vertical-align: middle;
			background-color: #f2f2f2;
			padding: 6px 4px;
		}
		/* Thêm nút bấm */
		.search-container {
			margin-bottom: 20px;
			display: flex;
			gap: 10px; /* Tạo khoảng cách giữa ô nhập và nút bấm */
			max-width: 400px;
		}
			#searchInput {
				flex: 1;
				padding: 8px 12px;
				font-size: 14px;
				border: 1px solid #ccc;
				border-radius: 4px;
			}
			.search-container button {
				padding: 8px 16px;
				font-size: 14px;
				background-color: #007bff;
				color: white;
				border: none;
				border-radius: 4px;
				cursor: pointer;
				font-weight: bold;
			}
			.search-container button:hover {
				background-color: #0056b3; /* Đổi màu nhẹ khi di chuột vào nút */
			}
			.no-results {
				color: #dc3545;
				font-style: italic;
			}
		
    </style>
</head>
